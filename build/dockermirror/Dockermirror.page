<?php
// dockermirror - Docker registry mirror switcher
$plugin = 'dockermirror';
$config_dir = '/boot/config/plugins/'.$plugin;
$config_file = $config_dir.'/'.$plugin.'.cfg';

// Read saved config
$cfg = @parse_ini_file($config_file);
$saved = isset($cfg['MIRRORS']) ? trim($cfg['MIRRORS']) : '';

// Preset mirrors
$presets = array(
  'none'        => array('name'=>'不使用镜像源（默认）', 'url'=>'', 'desc'=>'直连 Docker Hub，不做加速'),
  'daocloud'    => array('name'=>'DaoCloud 加速', 'url'=>'https://docker.m.daocloud.io', 'desc'=>'公共加速，免注册'),
  'tencent'     => array('name'=>'腾讯云', 'url'=>'https://mirror.ccs.tencentyun.com', 'desc'=>'腾讯云公共镜像'),
  'netease'     => array('name'=>'网易', 'url'=>'https://hub-mirror.c.163.com', 'desc'=>'网易公开镜像'),
  'ms1'         => array('name'=>'毫秒镜像 1ms.run', 'url'=>'https://docker.1ms.run', 'desc'=>'公共加速'),
  'xuanyuan'    => array('name'=>'轩辕镜像', 'url'=>'https://docker.xuanyuan.run', 'desc'=>'公共加速'),
  'baidu'       => array('name'=>'百度', 'url'=>'https://mirror.baidubce.com', 'desc'=>'百度公开镜像'),
  'dockerproxy' => array('name'=>'DockerProxy', 'url'=>'https://dockerproxy.com', 'desc'=>'公共代理'),
  'aliyun'      => array('name'=>'阿里云（需专属地址）', 'url'=>'', 'desc'=>'在"自定义"中填入 https://xxxx.mirror.aliyuncs.com'),
);

// Determine selected preset
$selected_preset = 'custom';
if ($saved === '') {
    $selected_preset = 'none';
} else {
    foreach ($presets as $k => $v) {
        if ($v['url'] !== '' && $v['url'] === $saved) { $selected_preset = $k; break; }
    }
}
$saved_lines = $saved === '' ? '' : implode("\n", explode(',', $saved));

// Docker status
$docker_running = (trim(@shell_exec('docker info >/dev/null 2>&1; echo $?')) === '0');
$effective = array();
$info = @shell_exec('docker info 2>/dev/null');
if ($info && preg_match('/Registry Mirrors:\s*\n((?:\s+https?:\/\/\S+\s*\n)+)/', $info, $m)) {
    $effective = preg_split('/\s+/', trim($m[1]), -1, PREG_SPLIT_NO_EMPTY);
}
?>
