    <div class="row"><span>Docker 服务</span>
      <span class="tag <?php echo $docker_running?'on':'off'; ?>"><?php echo $docker_running?'运行中':'未运行'; ?></span></div>
    <div class="row"><span>当前生效镜像源</span>
      <span><?php echo $docker_running ? (count($effective)?implode('、 ',$effective):'（无，直连 Docker Hub）') : '—'; ?></span></div>
    <div class="row"><span>插件已保存镜像源</span>
      <span><?php echo $saved===''?'（无）':implode('、 ',explode(',',$saved)); ?></span></div>
  </div>

  <!-- Unraid 标准表单：action="/update.php", target="progressFrame" -->
  <form method="post" action="/update.php" target="progressFrame">
    <input type="hidden" name="csrf_token" value="<?php echo isset($var['csrf_token']) ? $var['csrf_token'] : ''; ?>">
    <!-- #file 告诉 Unraid 要保存哪个配置文件 -->
    <input type="hidden" name="#file" value="dockermirror/dockermirror.cfg">

    <div class="dm-card">
      <h2>选择镜像源</h2>
      <div class="preset-grid">
        <?php foreach ($presets as $k=>$v): ?>
        <label class="preset <?php echo $selected_preset===$k?'sel':''; ?>" onclick="selPreset('<?php echo $k; ?>')">
          <div><input type="radio" name="MIRRORS" value="<?php echo htmlspecialchars($v['url']); ?>" id="p_<?php echo $k; ?>" <?php echo $selected_preset===$k?'checked':''; ?> onchange="selPreset('<?php echo $k; ?>')">
          <span class="pn"><?php echo htmlspecialchars($v['name']); ?></span></div>
          <div class="pd"><?php echo htmlspecialchars($v['desc']); ?></div>
        </label>
        <?php endforeach; ?>
      </div>
      <div class="hint">点选任一预设后点击"保存"即可。阿里云等需专属地址的，请在下方"自定义"中填写。</div>
    </div>

    <div class="dm-card">
      <h2>自定义镜像源</h2>
      <label><input type="radio" name="MIRRORS_CUSTOM" value="1" id="src_custom" <?php echo $selected_preset==='custom'?'checked':''; ?> onchange="pickCustom()"> 使用下方自定义地址</label>
      <div style="margin-top:10px;">
        <textarea name="MIRRORS_CUSTOM_URL" id="custom_box" placeholder="每行一个镜像源地址，例如：&#10;https://docker.m.daocloud.io&#10;https://mirror.ccs.tencentyun.com" oninput="pickCustom()" onfocus="pickCustom()"><?php echo htmlspecialchars($saved_lines); ?></textarea>
        <div class="hint">每行一个地址，需以 http:// 或 https:// 开头，可填多个（按顺序尝试）。</div>
      </div>
    </div>

    <!-- Unraid 标准按钮：#default 恢复默认，#apply 保存并执行 #command -->
    <div style="margin:6px 0 18px;">
      <input type="submit" name="#default" value="恢复默认设置" class="btn btn-ghost">
      <input type="submit" name="#apply" value="保存并应用" class="btn btn-primary">
    </div>
  </form>

  <div class="dm-card">
    <h2>说明</h2>
    <ul>
      <li>镜像源（registry-mirrors）仅加速 Docker Hub（docker.io）的拉取。</li>
      <li>配置保存在 U 盘（/boot/config/plugins/dockermirror），并在每次开机/系统就绪时自动重新写入，重启不丢失。</li>
      <li>请勿与 Unraid 自带 Docker 设置页的"Registry Mirrors"重复设置，以本插件为准。</li>
    </ul>
  </div>
</div>

<script>
// 确保 #apply 按钮始终可用（Unraid 默认 disabled，我们的自定义 radio 不会触发 dirty 检测）
$(function(){
  $('input[name="#apply"]').prop('disabled', false);
});

function selPreset(k){
  document.querySelectorAll('.preset').forEach(function(e){e.classList.remove('sel');});
  var r = document.getElementById('p_'+k);
  if(r){ r.checked = true; var lbl = r.closest('.preset'); if(lbl) lbl.classList.add('sel'); }
  var sc = document.getElementById('src_custom'); if(sc) sc.checked = false;
}
function pickCustom(){
  var sc = document.getElementById('src_custom'); if(sc) sc.checked = true;
  document.querySelectorAll('.preset').forEach(function(e){e.classList.remove('sel');});
  document.querySelectorAll('input[name=MIRRORS]').forEach(function(e){e.checked=false;});
}
</script>
