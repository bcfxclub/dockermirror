<div class="dm-wrap">
  <h1 style="font-size:20px;margin:0 0 4px;">Docker 镜像源切换</h1>
  <p style="margin:0 0 14px;color:#666;font-size:13px;">
    一键切换 Docker 镜像加速源。配置保存在 U 盘，开机自动写入；<strong>安装/卸载本插件不会重启 Docker</strong>，只有点击「保存并应用」且镜像源确实变化时才重启。
  </p>

  <div class="dm-card">
    <h2>当前状态</h2>
    <div class="dm-row">
      <span>Docker 服务</span>
      <span class="dm-tag <?php echo $docker_running ? 'on' : 'off'; ?>"><?php echo $docker_running ? '运行中' : '未运行'; ?></span>
    </div>
    <div class="dm-row">
      <span>当前生效镜像源</span>
      <span><?php echo $docker_running ? (count($effective) ? implode('、', $effective) : '（无，直连 Docker Hub）') : '—'; ?></span>
    </div>
    <div class="dm-row">
      <span>插件已保存镜像源</span>
      <span><?php echo $saved === '' ? '（无）' : implode('、', explode(',', $saved)); ?></span>
    </div>
  </div>

  <form method="post" action="/update.php" target="progressFrame" id="dm_form">
    <input type="hidden" name="csrf_token" value="<?php echo isset($var['csrf_token']) ? $var['csrf_token'] : ''; ?>">
    <input type="hidden" name="#file" value="dockermirror/dockermirror.cfg">
    <input type="hidden" name="MIRRORS" id="dm_mirrors" value="<?php echo htmlspecialchars($saved); ?>">

    <div class="dm-card">
      <h2>选择镜像源</h2>
      <div class="dm-grid">
        <?php foreach ($presets as $k => $v): ?>
        <label class="dm-preset <?php echo $selected === $k ? 'sel' : ''; ?>" data-key="<?php echo $k; ?>">
          <div>
            <input type="radio" name="dm_preset" value="<?php echo htmlspecialchars($v['url']); ?>"
                   data-key="<?php echo $k; ?>" <?php echo $selected === $k ? 'checked' : ''; ?>>
            <span class="pn"><?php echo htmlspecialchars($v['name']); ?></span>
          </div>
          <div class="pd"><?php echo htmlspecialchars($v['desc']); ?></div>
        </label>
        <?php endforeach; ?>
      </div>
      <div class="dm-hint">阿里云等需要专属地址的镜像源，请在下方「自定义」中填写。</div>
    </div>

    <div class="dm-card">
      <h2>自定义镜像源</h2>
      <label>
        <input type="radio" name="dm_preset" value="__custom__" id="dm_custom_radio"
               <?php echo $selected === 'custom' ? 'checked' : ''; ?>>
        使用下方自定义地址
      </label>
      <div style="margin-top:10px;">
        <textarea class="dm-area" id="dm_custom" placeholder="每行一个镜像源地址，例如：&#10;https://docker.m.daocloud.io&#10;https://mirror.ccs.tencentyun.com"><?php echo htmlspecialchars($custom_text); ?></textarea>
        <div class="dm-hint">每行一个地址，需以 http:// 或 https:// 开头，可填多个（按顺序尝试）。</div>
      </div>
    </div>

    <div style="margin:6px 0 18px;">
      <input type="submit" name="#default" value="恢复默认设置" class="dm-btn dm-btn-ghost">
      <input type="submit" name="#apply"   value="保存并应用"   class="dm-btn dm-btn-primary" id="dm_apply">
    </div>
  </form>

  <div class="dm-card">
    <h2>说明</h2>
    <ul>
      <li>镜像源（registry-mirrors）用于加速 Docker Hub（docker.io）的镜像拉取。</li>
      <li>配置保存在 U 盘 <code>/boot/config/plugins/dockermirror/</code>，开机自动重写，重启不丢失。</li>
      <li>安装、卸载插件都不会重启 Docker，不会中断正在运行的容器。</li>
      <li>点击「保存并应用」后，若镜像源确有变化，Docker 会在后台重启（约需十几秒），请稍候刷新查看。</li>
      <li>请勿在 Unraid 自带 Docker 设置页重复设置 Registry Mirrors，以本插件为准。</li>
    </ul>
  </div>
</div>

<script>
$(function(){
  var $form = $('#dm_form');

  /* 组装 MIRRORS：把多行自定义地址转成逗号分隔 */
  function syncMirrors(){
    var $checked = $('input[name=dm_preset]:checked');
    var val = $checked.length ? $checked.val() : '';
    if (val === '__custom__') {
      var lines = $('#dm_custom').val().split('\n')
        .map(function(s){ return s.trim(); })
        .filter(function(s){ return s.length > 0; });
      val = lines.join(',');
    }
    $('#dm_mirrors').val(val);
  }

  /* 预设点击：高亮 + 同步 */
  $('.dm-preset').on('click', function(){
    $('.dm-preset').removeClass('sel');
    $(this).addClass('sel');
    $(this).find('input[name=dm_preset]').prop('checked', true);
    syncMirrors();
  });

  /* 自定义文本域：输入即切到自定义模式 */
  $('#dm_custom').on('input focus', function(){
    $('#dm_custom_radio').prop('checked', true);
    $('.dm-preset').removeClass('sel');
    syncMirrors();
  });

  /* 提交前同步一次，确保 MIRRORS 正确 */
  $form.on('submit', function(){ syncMirrors(); });

  /* 确保按钮可用（Unraid 默认可能因未检测到改动而禁用） */
  $('#dm_apply, input[name="#default"]').prop('disabled', false);

  syncMirrors();
});
</script>
