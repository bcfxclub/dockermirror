<?php
/* dockermirror - Docker 镜像源切换（中文本地化） */
$plugin      = 'dockermirror';
$config_dir  = '/boot/config/plugins/'.$plugin;
$config_file = $config_dir.'/'.$plugin.'.cfg';

/* 读取已保存配置 */
$saved = '';
if (is_readable($config_file)) {
  $raw = @file($config_file, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
  if ($raw) {
    foreach ($raw as $line) {
      if (preg_match('/^\s*MIRRORS\s*=\s*(.*)$/', $line, $m)) {
        $saved = trim($m[1], " \t\n\r\0\x0B\"'");
        break;
      }
    }
  }
}

/* 预设镜像源 */
$presets = array(
  'none'     => array('name'=>'不使用镜像源（默认）', 'url'=>'',  'desc'=>'直连 Docker Hub，不做加速'),
  'daocloud' => array('name'=>'DaoCloud',            'url'=>'https://docker.m.daocloud.io',      'desc'=>'公共加速，免注册'),
  'tencent'  => array('name'=>'腾讯云',              'url'=>'https://mirror.ccs.tencentyun.com', 'desc'=>'腾讯云公共镜像'),
  'netease'  => array('name'=>'网易',                'url'=>'https://hub-mirror.c.163.com',      'desc'=>'网易公开镜像'),
  'baidu'    => array('name'=>'百度',                'url'=>'https://mirror.baidubce.com',       'desc'=>'百度公开镜像'),
  'ms1'      => array('name'=>'毫秒镜像',            'url'=>'https://docker.1ms.run',            'desc'=>'公共加速'),
  'xuanyuan' => array('name'=>'轩辕镜像',            'url'=>'https://docker.xuanyuan.run',       'desc'=>'公共加速'),
);

/* 判断当前选中项 */
$selected = 'custom';
if ($saved === '') {
  $selected = 'none';
} else {
  foreach ($presets as $k => $v) {
    if ($v['url'] !== '' && $v['url'] === $saved) { $selected = $k; break; }
  }
}
$custom_text = ($selected === 'custom') ? implode("\n", explode(',', $saved)) : '';

/* Docker 运行状态与当前生效镜像源 */
$docker_running = (trim(@shell_exec('docker info >/dev/null 2>&1; echo $?')) === '0');
$effective = array();
if ($docker_running) {
  $info = @shell_exec('docker info --format "{{json .RegistryConfig.Mirrors}}" 2>/dev/null');
  if ($info) {
    $decoded = @json_decode(trim($info), true);
    if (is_array($decoded)) { $effective = array_values(array_filter($decoded)); }
  }
}
?>
<style>
