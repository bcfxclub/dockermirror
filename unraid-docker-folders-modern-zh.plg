<?xml version="1.0"?>
<PLUGIN name="unraid-docker-folders-modern" version="2026.10.29-zh1" author="Kevin(zh)"
        pluginURL="" pluginWebPage="" launch="Docker/Folders" min="7.0.0">
<CHANGES>
* 2026.10.29-zh1 - Docker Folders Chinese local offline build
  - Full Chinese UI: Vue3 frontend + .page menu titles
  - Self-contained: .txz embedded as base64, zero network during install
  - Offline backend: built-in PHP backend (GraphQL plugin needs network, disabled)
  - Official install logic kept: migrations, permissions, cron restore, event hooks, verify
</CHANGES>

<!-- Self-contained offline install: decode embedded base64 -> installpkg -> post-install -->
<FILE Run="/bin/bash"><INLINE><![CDATA[
bash <<'DFINSTALL'
PLUGIN_NAME="unraid-docker-folders-modern"
CONFIG_DIR="/boot/config/plugins/${PLUGIN_NAME}"
VERSION="2026.10.29-zh1"
mkdir -p "${CONFIG_DIR}"
TXZ_PATH="${CONFIG_DIR}/${PLUGIN_NAME}-${VERSION}.txz"

