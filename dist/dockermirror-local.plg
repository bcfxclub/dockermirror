<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name    "dockermirror">
<!ENTITY author  "Kevin">
<!ENTITY version "2026.10.30">
]>
<PLUGIN name="&name;"
        author="&author;"
        version="&version;"
        pluginURL=""
        launch="Settings/Dockermirror"
        icon="globe"
        min="6.9.0">

<CHANGES>
### 2026.10.30
- 本地自包含版：插件文件内嵌，无需外网即可安装。
- 安装/卸载不重启任何服务，不会出现「操作将在后台继续进行」提示。
- 安装、卸载、开机均不重启 Docker。
</CHANGES>

<DESCRIPTION>
一键切换 Docker 镜像加速源（本地离线安装版）。配置保存至 U 盘，开机自动生效、重启不丢失。
</DESCRIPTION>

<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
#!/bin/bash
NAME="dockermirror"
VER="2026.10.30"
CONFIG="/boot/config/plugins/${NAME}"
PLUGIN_DIR="/usr/local/emhttp/plugins/${NAME}"
B64="${CONFIG}/.bundle.b64"
TGZ="${CONFIG}/${NAME}-${VER}.tgz"

mkdir -p "${CONFIG}" "${PLUGIN_DIR}"
